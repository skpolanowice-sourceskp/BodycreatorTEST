# ==========================================================
# Body Creator — konfiguracja Apache
# Cel: jeden kanoniczny adres + wydajnosc
# ==========================================================

# ----------------------------------------------------------
# 1. PRZEKIEROWANIA KANONICZNE
# Docelowy adres: https://bodycreator.com.pl (bez www)
# Zgodny z <link rel="canonical"> we wszystkich plikach HTML
# oraz z adresami w sitemap.xml.
# ----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Wymuszenie HTTPS.
    # Trzy niezalezne warunki musza byc spelnione naraz, zeby uznac
    # polaczenie za nieszyfrowane. To zabezpieczenie przed petla
    # przekierowan na hostingach, gdzie SSL konczy sie na proxy/CDN
    # i %{HTTPS} mylnie raportuje "off".
    RewriteCond %{HTTPS} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://bodycreator.com.pl/$1 [R=301,L]

    # Usuniecie www — Google indeksuje obecnie wariant z www,
    # co rozjezdza sie z canonical wskazujacym na wersje bez www.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------
# 2. KOMPRESJA
# ----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/rss+xml
</IfModule>

# ----------------------------------------------------------
# 3. CACHE PRZEGLADARKI
# Filmy i grafiki sa statyczne i ciezkie — dlugi cache.
# HTML krotki, zeby zmiany tresci byly widoczne od razu.
# ----------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/html                 "access plus 1 hour"

    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType application/x-javascript  "access plus 1 year"

    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    ExpiresByType video/mp4                 "access plus 1 year"
    ExpiresByType video/webm                "access plus 1 year"

    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"

    ExpiresByType application/xml           "access plus 1 day"
    ExpiresByType text/plain                "access plus 1 day"
</IfModule>

# ----------------------------------------------------------
# 4. NAGLOWKI BEZPIECZENSTWA
# ----------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ----------------------------------------------------------
# 5. TYPY MIME
# Bez tego czesc hostingow serwuje webm/webp jako octet-stream.
# ----------------------------------------------------------
<IfModule mod_mime.c>
    AddType video/webm       .webm
    AddType image/webp       .webp
    AddType font/woff2       .woff2
    AddType application/xml  .xml
</IfModule>

# ----------------------------------------------------------
# 6. OCHRONA PLIKOW ROBOCZYCH
# robots.txt tylko prosi crawlery, zeby ich nie indeksowaly —
# tutaj blokujemy dostep faktycznie.
# ----------------------------------------------------------
# Negatywny lookahead na poczatku gwarantuje, ze robots.txt i pliki
# manifestu NIGDY nie zostana dopasowane przez ta regule. Dzieki temu
# nie zalezymy od kolejnosci scalania sekcji <FilesMatch> przez Apache.
# sitemap.xml jest bezpieczny — rozszerzenie .xml nie jest na liscie.
<FilesMatch "^(?!robots\.txt$|manifest\.json$|site\.webmanifest$).*\.(psd|psb|rar|json|md|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Ukrycie plikow zaczynajacych sie od kropki (.htaccess, .git itd.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
