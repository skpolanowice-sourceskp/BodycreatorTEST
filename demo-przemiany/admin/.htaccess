# Panel Przemian: bez indeksowania i bez cache przeglądarki.
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Cache-Control "no-store"
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

# Pliki pomocnicze nie są dostępne z przeglądarki (lib.php, narzędzie hasła, seed)
<FilesMatch "^(lib\.php|ustaw-haslo\.php|seed\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
